BACKEND_IMAGE=acc-system-backend:local
FRONTEND_IMAGE=acc-system-frontend:local
NGINX_IMAGE=acc-system-nginx:local
AGENT_IMAGE=acc-system-agent:local
AGENT_URL=http://agent:8000
# MOCK is only allowed with ENVIRONMENT=development; use REMOTE for a real provider.
AGENT_CLASSIFICATION_PROVIDER=DISABLED
AGENT_REVIEW_PROVIDER=DISABLED
MODEL_API_URL=
MODEL_HEALTH_URL=
MODEL_API_KEY=
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_REQUEST_TIMEOUT_SECONDS=300

POSTGRES_IMAGE=postgres:17.6-alpine
POSTGRES_DB=acc
POSTGRES_USER=acc
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql+psycopg://acc:change-me-postgres@postgres:5432/acc

REDIS_IMAGE=redis:8.2.1-alpine
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@redis:6379/0

JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_ISSUER=acc-system
JWT_AUDIENCE=acc-system-web
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost

BOOTSTRAP_FIRM_NAME=Local Accounting
BOOTSTRAP_ADMIN_NAME=Local Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

WORKER_POLL_SECONDS=10
MAX_UPLOAD_BYTES=26214400

# Production: set CLAMAV_HOST=clamav and start Compose with --profile malware-scan.
CLAMAV_IMAGE=clamav/clamav:1.4
CLAMAV_HOST=
CLAMAV_PORT=3310
