{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:ap-southeast-1:<AWS_ACCOUNT_ID>:repository/acc-system-backend",
        "arn:aws:ecr:ap-southeast-1:<AWS_ACCOUNT_ID>:repository/acc-system-frontend",
        "arn:aws:ecr:ap-southeast-1:<AWS_ACCOUNT_ID>:repository/acc-system-nginx",
        "arn:aws:ecr:ap-southeast-1:<AWS_ACCOUNT_ID>:repository/acc-system-agent"
      ]
    }
  ]
}
